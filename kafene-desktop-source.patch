diff --git a/kafene-desktop/forge.config.cjs b/kafene-desktop/forge.config.cjs
new file mode 100644
index 0000000000..b281836d81
--- /dev/null
+++ b/kafene-desktop/forge.config.cjs
@@ -0,0 +1,57 @@
+const fs = require('node:fs/promises');
+const path = require('node:path');
+
+const icon = path.join(__dirname, 'assets', 'kafene.ico');
+const webSource = process.env.KAFENE_WEB_DIR
+  ? path.resolve(process.env.KAFENE_WEB_DIR)
+  : path.join(__dirname, 'web');
+const notices = [
+  ['LICENSE-AFFiNE.txt', '../LICENSE'],
+  ['LICENSE-AFFiNE-MIT.txt', '../LICENSE-MIT'],
+  ['LICENSE-Excalidraw.txt', '../packages/frontend/core/public/LICENSE-Excalidraw.txt'],
+];
+
+module.exports = {
+  packagerConfig: {
+    name: 'Kafene',
+    executableName: 'Kafene',
+    appBundleId: 'app.kafene.desktop',
+    asar: true,
+    icon,
+    electronZipDir: process.env.KAFENE_ELECTRON_ZIP_DIR,
+    win32metadata: {
+      CompanyName: 'Kafene',
+      FileDescription: 'Kafene productivity workspace',
+    },
+    ignore: [
+      /^\/(?!assets(?:\/|$)|(?:main\.cjs|native-mcp-server\.cjs|package\.json)$).+/,
+    ],
+  },
+  hooks: {
+    async prePackage() {
+      const entry = await fs.stat(path.join(webSource, 'index.html')).catch(() => null);
+      if (!entry?.isFile()) {
+        throw new Error(`No built web entry in ${webSource}. Set KAFENE_WEB_DIR to an existing web dist.`);
+      }
+    },
+    async packageAfterCopy(_config, buildPath) {
+      await fs.cp(webSource, path.join(buildPath, 'web'), { recursive: true, dereference: true });
+      const licenseDir = path.join(buildPath, 'licenses');
+      await fs.mkdir(licenseDir, { recursive: true });
+      await Promise.all(notices.map(([filename, source]) =>
+        fs.copyFile(path.resolve(__dirname, source), path.join(licenseDir, filename))
+      ));
+    },
+  },
+  makers: [{
+    name: '@electron-forge/maker-squirrel',
+    config: {
+      name: 'Kafene',
+      setupExe: 'Kafene-Setup.exe',
+      setupIcon: icon,
+      // Omit NuGet's remote icon field; Windows uses the embedded icons.
+      nuspecTemplate: path.join(__dirname, 'scripts', 'kafene.nuspec'),
+      copyright: 'Copyright (c) 2022-present TOEVERYTHING PTE. LTD. and its affiliates.',
+    },
+  }],
+};
diff --git a/kafene-desktop/main.cjs b/kafene-desktop/main.cjs
new file mode 100644
index 0000000000..9ffa4dba13
--- /dev/null
+++ b/kafene-desktop/main.cjs
@@ -0,0 +1,111 @@
+const { app, BrowserWindow, shell } = require('electron');
+const http = require('node:http');
+const fs = require('node:fs');
+const path = require('node:path');
+const PORT = 49327;
+const root = path.join(__dirname, 'web');
+const icon = path.join(__dirname, 'assets', 'kafene.ico');
+if (process.platform === 'win32') app.setAppUserModelId('com.squirrel.Kafene.Kafene');
+const mime = { '.html':'text/html; charset=utf-8', '.js':'text/javascript; charset=utf-8', '.css':'text/css; charset=utf-8', '.json':'application/json', '.svg':'image/svg+xml', '.png':'image/png', '.ico':'image/x-icon', '.woff':'font/woff', '.woff2':'font/woff2', '.wasm':'application/wasm', '.webmanifest':'application/manifest+json', '.map':'application/json' };
+let server;
+const pending = new Map();
+const commands = [];
+let nextCommandId = 1;
+function json(res, status, value) {
+  res.writeHead(status, { 'Content-Type': 'application/json; charset=utf-8', 'Cache-Control': 'no-store' });
+  res.end(JSON.stringify(value));
+}
+function readJson(req) {
+  return new Promise((resolve, reject) => {
+    let body = '';
+    req.on('data', chunk => {
+      body += chunk;
+      if (body.length > 1048576) { reject(new Error('Request too large')); req.destroy(); }
+    });
+    req.on('end', () => { try { resolve(JSON.parse(body)); } catch { reject(new Error('Invalid JSON')); } });
+    req.on('error', reject);
+  });
+}
+function isLocalOrigin(req) {
+  const origin = req.headers.origin;
+  return !origin || origin === `http://127.0.0.1:${PORT}`;
+}
+async function agentRoute(req, res, pathname) {
+  if (!isLocalOrigin(req)) return json(res, 403, { error: 'Invalid origin' });
+  if (pathname === '/kafene/agent/commands' && req.method === 'POST') {
+    if (req.headers['x-kafene-agent'] !== 'mcp') return json(res, 403, { error: 'Agent header required' });
+    try {
+      const command = await readJson(req);
+      if (!command || typeof command.action !== 'string') return json(res, 400, { error: 'Invalid command' });
+      const id = String(nextCommandId++);
+      const timeout = setTimeout(() => {
+        pending.delete(id);
+        const queued = commands.findIndex(item => item.id === id);
+        if (queued >= 0) commands.splice(queued, 1);
+        if (!res.destroyed) json(res, 504, { error: 'Kafene workspace is not open' });
+      }, 30000);
+      pending.set(id, { res, timeout });
+      commands.push({ id, command });
+    } catch (error) { if (!res.destroyed) json(res, 400, { error: error.message }); }
+    return;
+  }
+  if (pathname === '/kafene/agent/next' && req.method === 'GET') {
+    if (req.headers['x-kafene-agent'] !== 'renderer') return json(res, 403, { error: 'Renderer header required' });
+    return json(res, 200, { commands: commands.splice(0, 20) });
+  }
+  const match = pathname.match(/^\/kafene\/agent\/results\/(\d+)$/);
+  if (match && req.method === 'POST') {
+    if (req.headers['x-kafene-agent'] !== 'renderer') return json(res, 403, { error: 'Renderer header required' });
+    const item = pending.get(match[1]);
+    if (!item) return json(res, 404, { error: 'Command expired' });
+    try {
+      const result = await readJson(req);
+      clearTimeout(item.timeout);
+      pending.delete(match[1]);
+      json(item.res, result.error ? 400 : 200, result);
+      return json(res, 200, { ok: true });
+    } catch (error) { return json(res, 400, { error: error.message }); }
+  }
+  return json(res, 404, { error: 'Unknown agent route' });
+}
+function openWindow() {
+  const window = new BrowserWindow({ width: 1440, height: 900, minWidth: 800, minHeight: 600, title: 'Kafene', icon, backgroundColor: '#171717', webPreferences: { contextIsolation: true, nodeIntegration: false, sandbox: true } });
+  window.on('page-title-updated', event => { event.preventDefault(); window.setTitle('Kafene'); });
+  window.webContents.setWindowOpenHandler(({url}) => { if (/^https?:\/\//i.test(url)) shell.openExternal(url); return {action:'deny'}; });
+  window.webContents.on('will-navigate', (event, url) => { if (!url.startsWith(`http://127.0.0.1:${PORT}/`)) { event.preventDefault(); if (/^https?:\/\//i.test(url)) shell.openExternal(url); } });
+  window.loadURL(`http://127.0.0.1:${PORT}/`);
+}
+const squirrelEvent = process.argv.find(arg => ['--squirrel-install', '--squirrel-updated', '--squirrel-uninstall', '--squirrel-obsolete'].includes(arg));
+if (squirrelEvent) {
+  const updater = path.resolve(path.dirname(process.execPath), '..', 'Update.exe');
+  const executable = path.basename(process.execPath);
+  const operation = squirrelEvent === '--squirrel-uninstall' ? '--removeShortcut' : '--createShortcut';
+  if (squirrelEvent !== '--squirrel-obsolete' && fs.existsSync(updater)) {
+    require('node:child_process').spawn(updater, [operation, executable], { detached: true, stdio: 'ignore' }).unref();
+  }
+  setTimeout(() => app.quit(), 1000);
+} else if (!app.requestSingleInstanceLock()) app.quit();
+else {
+  app.on('second-instance', () => { const window = BrowserWindow.getAllWindows()[0]; if (window) { if (window.isMinimized()) window.restore(); window.focus(); } });
+  app.whenReady().then(() => {
+    const mcpDir = path.join(app.getPath('userData'), 'mcp');
+    fs.mkdirSync(mcpDir, { recursive: true });
+    fs.copyFileSync(path.join(__dirname, 'native-mcp-server.cjs'), path.join(mcpDir, 'native-mcp-server.cjs'));
+    server = http.createServer((req, res) => {
+      let pathname;
+      try { pathname = decodeURIComponent(new URL(req.url, `http://127.0.0.1:${PORT}`).pathname); } catch { res.writeHead(400).end(); return; }
+      if (pathname.startsWith('/kafene/agent/')) { void agentRoute(req, res, pathname); return; }
+      if (pathname.startsWith('/api/') || pathname === '/graphql') { res.writeHead(503, {'Content-Type':'application/json'}).end(JSON.stringify({error:'Cloud service unavailable'})); return; }
+      const resolved = path.resolve(root, '.' + pathname);
+      if (resolved !== root && !resolved.startsWith(root + path.sep)) { res.writeHead(403).end(); return; }
+      let file = resolved;
+      if (!fs.existsSync(file) || fs.statSync(file).isDirectory()) file = path.join(root, 'index.html');
+      res.writeHead(200, { 'Content-Type': mime[path.extname(file).toLowerCase()] || 'application/octet-stream' });
+      fs.createReadStream(file).on('error', () => res.destroy()).pipe(res);
+    });
+    server.on('error', error => { require('electron').dialog.showErrorBox('Kafene could not start', `Local service could not start: ${error.message}`); app.quit(); });
+    server.listen(PORT, '127.0.0.1', openWindow);
+  });
+  app.on('window-all-closed', () => app.quit());
+  app.on('before-quit', () => server?.close());
+}
diff --git a/kafene-desktop/native-mcp-server.cjs b/kafene-desktop/native-mcp-server.cjs
new file mode 100644
index 0000000000..3f3f31f28c
--- /dev/null
+++ b/kafene-desktop/native-mcp-server.cjs
@@ -0,0 +1,49 @@
+const readline = require('node:readline');
+
+const endpoint = 'http://127.0.0.1:49327/kafene/agent/commands';
+const blockSchema = {
+  type: 'array',
+  description: 'Ordered native AFFiNE blocks. Kinds: heading (text, level 1–3), paragraph, quote, code (text, language), todo (text, checked), bullet, callout (text, emoji, color), divider, database (title, rows, calendar, columns, progress). Database columns can include date, focus, done, score. Set progress true for a live percent checked footer. Database rows accept text, date YYYY-MM-DD, area, done, score.',
+  items: { type: 'object' },
+};
+const tools = [
+  { name: 'kafene_native_guide', description: 'Read the native Kafene dashboard design guide before creating an entire dashboard.', inputSchema: { type: 'object', properties: {} } },
+  { name: 'kafene_list_pages', description: 'List Kafene workspace pages and native dashboards.', inputSchema: { type: 'object', properties: {} } },
+  { name: 'kafene_get_page', description: 'Read the editable native blocks, database columns, and rows of a page.', inputSchema: { type: 'object', properties: { docId: { type: 'string' } }, required: ['docId'] } },
+  { name: 'kafene_create_page', description: 'Create a complete editable page in Kafene using native AFFiNE blocks. Use this to build whole dashboards and templates.', inputSchema: { type: 'object', properties: { title: { type: 'string' }, isTemplate: { type: 'boolean' }, blocks: blockSchema }, required: ['title', 'blocks'] } },
+  { name: 'kafene_append_blocks', description: 'Append native editable blocks to a Kafene page.', inputSchema: { type: 'object', properties: { docId: { type: 'string' }, blocks: blockSchema }, required: ['docId', 'blocks'] } },
+  { name: 'kafene_update_todo', description: 'Mark a native to-do block complete or incomplete.', inputSchema: { type: 'object', properties: { docId: { type: 'string' }, blockId: { type: 'string' }, checked: { type: 'boolean' } }, required: ['docId', 'blockId', 'checked'] } },
+  { name: 'kafene_add_database_row', description: 'Add a row to a native database table or calendar.', inputSchema: { type: 'object', properties: { docId: { type: 'string' }, databaseId: { type: 'string' }, text: { type: 'string' }, cells: { type: 'object' } }, required: ['docId', 'databaseId', 'text'] } },
+  { name: 'kafene_update_database_row', description: 'Update an existing native database row, including its Done checkbox, Date, Focus, or Score.', inputSchema: { type: 'object', properties: { docId: { type: 'string' }, databaseId: { type: 'string' }, rowId: { type: 'string' }, text: { type: 'string' }, cells: { type: 'object' } }, required: ['docId', 'databaseId', 'rowId'] } },
+];
+const guide = `Build Kafene pages using only native AFFiNE blocks. Use a strong page title, clear headings, concise explanations, callouts, to-dos, dividers, and native databases when useful. For programming notes use {"kind":"code","text":"package main\\n\\nfunc main() {}","language":"go"}; this creates an editable Kafene code block with syntax highlighting. A database has a table view and optional calendar view. Every row is editable in Kafene. Do not generate HTML, CSS, card JSON, or static progress percentages. Read the existing page before modifying it and preserve user edits. Example callout: {"kind":"callout","text":"Today: 90 minutes of VARC + one DILR set","emoji":"🎯","color":"blue"}. Example database: {"kind":"database","title":"Daily plan","calendar":true,"columns":["date","focus","done"],"progress":true,"rows":[{"text":"Read one RC passage and review errors","date":"2026-11-09","area":"VARC","done":false}]}. The progress footer calculates percent checked from Done. Supported colors: grey, blue, green, yellow, purple, pink. Kafene is offline first; AI client tool calls may share data with online models.`;
+
+async function execute(name, args) {
+  if (name === 'kafene_native_guide') return guide;
+  const action = name.replace(/^kafene_/, '');
+  const response = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json', 'X-Kafene-Agent': 'mcp' }, body: JSON.stringify({ action, ...args }) });
+  const body = await response.json();
+  if (!response.ok) throw new Error(body.error || `Kafene returned ${response.status}`);
+  return body;
+}
+
+function send(message) { process.stdout.write(JSON.stringify(message) + '\n'); }
+const input = readline.createInterface({ input: process.stdin });
+input.on('line', async line => {
+  let request;
+  try { request = JSON.parse(line); } catch { return; }
+  if (request.id === undefined) return;
+  try {
+    let result;
+    if (request.method === 'initialize') result = { protocolVersion: '2025-03-26', capabilities: { tools: {} }, serverInfo: { name: 'kafene-native', version: '1.0.0' } };
+    else if (request.method === 'tools/list') result = { tools };
+    else if (request.method === 'tools/call') {
+      const value = await execute(request.params?.name, request.params?.arguments || {});
+      result = { content: [{ type: 'text', text: typeof value === 'string' ? value : JSON.stringify(value) }] };
+    } else throw new Error(`Unknown method: ${request.method}`);
+    send({ jsonrpc: '2.0', id: request.id, result });
+  } catch (error) {
+    if (request.method === 'tools/call') send({ jsonrpc: '2.0', id: request.id, result: { isError: true, content: [{ type: 'text', text: error.message }] } });
+    else send({ jsonrpc: '2.0', id: request.id, error: { code: -32603, message: error.message } });
+  }
+});
diff --git a/kafene-desktop/package-lock.json b/kafene-desktop/package-lock.json
new file mode 100644
index 0000000000..8070fa23ed
--- /dev/null
+++ b/kafene-desktop/package-lock.json
@@ -0,0 +1,6211 @@
+{
+  "name": "kafene",
+  "version": "0.27.8",
+  "lockfileVersion": 3,
+  "requires": true,
