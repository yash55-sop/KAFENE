--- /dev/null
+++ b/packages/frontend/core/src/modules/whiteboard/scene.spec.ts
@@ -0,0 +1,300 @@
+import type { ExcalidrawElement } from '@excalidraw/excalidraw/element/types';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { applyUpdate, Doc, encodeStateAsUpdate } from 'yjs';
+
+import { createNavigableHistory } from '../../utils/navigable-history';
+import { createWhiteboardAutosave } from './autosave';
+import { protectWhiteboardNavigation } from './navigation';
+import {
+  canvasSettings,
+  copyWhiteboardData,
+  WHITEBOARD_DATA,
+  type WhiteboardScene,
+  WhiteboardSceneStore,
+} from './scene';
+
+const element = (id: string, version = 1) =>
+  ({
+    id,
+    type: 'rectangle',
+    version,
+    versionNonce: 1,
+    index: `a${id}`,
+    x: 10,
+    y: 20,
+    isDeleted: false,
+  }) as unknown as ExcalidrawElement;
+const scene = (id = '1', version = 1): WhiteboardScene => ({
+  elements: [element(id, version)],
+  appState: { viewBackgroundColor: '#ffffff', scrollX: 30 },
+  files: {},
+});
+
+describe('native whiteboard persistence', () => {
+  it('keeps Excalidraw conflict ordering for equal versions', () => {
+    const doc = new Doc(),
+      store = new WhiteboardSceneStore(doc);
+    const first = scene();
+    store.write(first);
+    store.write({
+      ...first,
+      elements: [{ ...first.elements[0], versionNonce: 2, x: 999 }],
+    });
+    expect(store.read().elements[0].x).toBe(10);
+  });
+  it('persists a reusable library and includes it in a duplicate', () => {
+    const source = new Doc(),
+      target = new Doc();
+    const store = new WhiteboardSceneStore(source);
+    store.writeLibrary([
+      {
+        id: 'library-item',
+        status: 'unpublished',
+        elements: [element('1')],
+        created: 1,
+      },
+    ]);
+    copyWhiteboardData(source, target);
+    expect(new WhiteboardSceneStore(target).readLibrary()[0].id).toBe(
+      'library-item'
+    );
+  });
+  it('round-trips elements, settings and embedded images through AFFiNE Yjs updates', () => {
+    const source = new Doc(),
+      target = new Doc();
+    const value = scene();
+    value.files = {
+      picture: {
+        id: 'picture',
+        dataURL: 'data:image/png;base64,abc',
+        mimeType: 'image/png',
+        created: 1,
+      },
+    } as unknown as WhiteboardScene['files'];
+    new WhiteboardSceneStore(source).write(value);
+    applyUpdate(target, encodeStateAsUpdate(source));
+    expect(new WhiteboardSceneStore(target).read()).toEqual(value);
+  });
+  it('does not write unchanged scenes and never serializes transient editor state', () => {
+    const doc = new Doc(),
+      store = new WhiteboardSceneStore(doc);
+    store.write(scene());
+    const update = vi.fn();
+    doc.on('update', update);
+    store.write(scene());
+    expect(update).not.toHaveBeenCalled();
+    expect(
+      canvasSettings({
+        theme: 'dark',
+        selectedElementIds: { secret: true },
+        viewBackgroundColor: '#000',
+      })
+    ).not.toHaveProperty('selectedElementIds');
+    expect(canvasSettings({ theme: 'dark' })).not.toHaveProperty('theme');
+  });
+  it('preserves other devices elements and does not overwrite newer versions with a stale scene', () => {
+    const doc = new Doc(),
+      store = new WhiteboardSceneStore(doc);
+    store.write(scene('1', 4));
+    store.write(scene('1', 2));
+    expect(store.read().elements[0].version).toBe(4);
+    const remote = new Doc();
+    applyUpdate(remote, encodeStateAsUpdate(doc));
+    const remoteStore = new WhiteboardSceneStore(remote);
+    remoteStore.write(scene('2'));
+    applyUpdate(doc, encodeStateAsUpdate(remote));
+    expect(store.read().elements.map(element => element.id)).toEqual([
+      '1',
+      '2',
+    ]);
+  });
+  it('replaces an imported drawing without resurrecting old elements', () => {
+    const doc = new Doc(),
+      store = new WhiteboardSceneStore(doc);
+    store.write(scene('1'));
+    store.read();
+    store.write(scene('2'));
+    expect(
+      store
+        .read()
+        .elements.filter(element => !element.isDeleted)
+        .map(element => element.id)
+    ).toEqual(['2']);
+  });
+  it('duplicates all data without sharing mutable scene state', () => {
+    const source = new Doc(),
+      target = new Doc();
+    new WhiteboardSceneStore(source).write(scene());
+    copyWhiteboardData(source, target);
+    new WhiteboardSceneStore(target).write(scene('1', 2));
+    expect(new WhiteboardSceneStore(source).read().elements[0].version).toBe(1);
+    expect(target.getMap(WHITEBOARD_DATA).size).toBeGreaterThan(0);
+  });
+  it('reports only external transactions to the editor', () => {
+    const doc = new Doc(),
+      store = new WhiteboardSceneStore(doc),
+      changed = vi.fn();
+    const dispose = store.observe(changed);
+    store.write(scene());
+    expect(changed).not.toHaveBeenCalled();
+    doc.getMap(WHITEBOARD_DATA).set('settings', '{}');
+    expect(changed).toHaveBeenCalledOnce();
+    dispose();
+    doc.getMap(WHITEBOARD_DATA).set('settings', '{"scrollX":5}');
+    expect(changed).toHaveBeenCalledOnce();
+  });
+});
+
+describe('autosave lifecycle', () => {
+  afterEach(() => vi.useRealTimers());
+  it('coalesces edits and flushes the newest scene on navigation', () => {
+    vi.useFakeTimers();
+    const write = vi.fn(),
+      save = createWhiteboardAutosave(write, vi.fn(), vi.fn());
+    save.save(scene('1', 1));
+    save.save(scene('1', 2));
+    expect(write).not.toHaveBeenCalled();
+    save.dispose();
+    expect(write).toHaveBeenCalledOnce();
+    expect(write.mock.calls[0][0].elements[0].version).toBe(2);
+    vi.runAllTimers();
+    expect(write).toHaveBeenCalledOnce();
+  });
+  it('commits continuous drawing at least every second', () => {
+    vi.useFakeTimers();
+    const write = vi.fn(),
+      save = createWhiteboardAutosave(write, vi.fn(), vi.fn());
+    for (let version = 1; version <= 10; version++) {
+      save.save(scene('1', version));
+      vi.advanceTimersByTime(100);
+    }
+    expect(write).toHaveBeenCalledOnce();
+    expect(save.pending).toBe(false);
+  });
+  it('retains a failed save for retry and never retries an older snapshot', () => {
+    const write = vi.fn().mockImplementationOnce(() => {
+        throw new Error('disk');
+      }),
+      error = vi.fn();
+    const save = createWhiteboardAutosave(write, error, vi.fn());
+    save.save(scene('1', 1));
+    save.flush();
+    expect(save.pending).toBe(true);
+    save.save(scene('1', 2));
+    save.flush();
+    expect(save.pending).toBe(false);
+    expect(error).toHaveBeenCalledOnce();
+    expect(write.mock.calls[1][0].elements[0].version).toBe(2);
+  });
+});
+
+describe('navigation waits for durable storage', () => {
+  it('also saves edits made while navigation is waiting on storage', async () => {
+    const history = createNavigableHistory({ initialEntries: ['/board'] });
+    const completions: (() => void)[] = [];
+    let pending = false;
+    const flush = vi.fn(() => {
+      pending = false;
+    });
+    const wait = vi.fn(
+      () =>
+        new Promise<void>(resolve => {
+          completions.push(resolve);
+        })
+    );
+    const dispose = protectWhiteboardNavigation(
+      history,
+      flush,
+      () => pending,
+      wait,
+      vi.fn()
+    );
+    history.push('/all');
+    pending = true;
+    completions[0]();
+    await vi.waitFor(() => expect(wait).toHaveBeenCalledTimes(2));
+    expect(history.location.pathname).toBe('/board');
+    completions[1]();
+    await vi.waitFor(() => expect(history.location.pathname).toBe('/all'));
+    expect(flush).toHaveBeenCalledTimes(2);
+    dispose();
+  });
+  it('keeps the canvas available when the storage engine rejects its write', async () => {
+    const history = createNavigableHistory({ initialEntries: ['/board'] }),
+      error = vi.fn();
+    const dispose = protectWhiteboardNavigation(
+      history,
+      vi.fn(),
+      () => false,
+      () => Promise.reject(new Error('Storage unavailable')),
+      error
+    );
+    history.push('/all');
+    await vi.waitFor(() => expect(error).toHaveBeenCalledOnce());
+    expect(history.location.pathname).toBe('/board');
+    dispose();
+  });
+  it('keeps the editor mounted until saved and honours the latest destination', async () => {
+    const history = createNavigableHistory({ initialEntries: ['/board'] });
+    let complete!: () => void;
+    const saved = new Promise<void>(resolve => {
+      complete = resolve;
+    });
+    const flush = vi.fn(),
+      error = vi.fn();
+    const dispose = protectWhiteboardNavigation(
+      history,
+      flush,
+      () => false,
+      () => saved,
+      error
+    );
+    history.push('/all');
+    history.push('/whiteboard');
+    expect(history.location.pathname).toBe('/board');
+    complete();
+    await vi.waitFor(() =>
+      expect(history.location.pathname).toBe('/whiteboard')
+    );
+    expect(flush).toHaveBeenCalledOnce();
+    expect(error).not.toHaveBeenCalled();
+    dispose();
+  });
+  it('retains the board on failure instead of discarding an unsaved scene', async () => {
+    const history = createNavigableHistory({ initialEntries: ['/board'] }),
+      error = vi.fn();
+    const dispose = protectWhiteboardNavigation(
+      history,
+      vi.fn(),
+      () => true,
+      vi.fn(),
+      error
+    );
+    history.push('/all');
+    await vi.waitFor(() => expect(error).toHaveBeenCalledOnce());
+    expect(history.location.pathname).toBe('/board');
+    dispose();
+  });
+  it('does not apply an asynchronous navigation after its workspace is disposed', async () => {
+    const history = createNavigableHistory({ initialEntries: ['/board'] });
+    let complete!: () => void;
+    const saved = new Promise<void>(resolve => {
+      complete = resolve;
+    });
+    const dispose = protectWhiteboardNavigation(
+      history,
+      vi.fn(),
+      () => false,
+      () => saved,
+      vi.fn()
+    );
+    history.push('/all');
+    dispose();
+    complete();
+    await Promise.resolve();
+    await Promise.resolve();
+    expect(history.location.pathname).toBe('/board');
+    history.push('/other');
+    expect(history.location.pathname).toBe('/other');
+  });
+});
diff --git a/packages/frontend/core/src/modules/whiteboard/scene.ts b/packages/frontend/core/src/modules/whiteboard/scene.ts
new file mode 100644
index 0000000000..89625a5798
--- /dev/null
+++ b/packages/frontend/core/src/modules/whiteboard/scene.ts
@@ -0,0 +1,160 @@
+import type { ExcalidrawElement } from '@excalidraw/excalidraw/element/types';
+import type {
+  AppState,
+  BinaryFiles,
+  LibraryItems,
+} from '@excalidraw/excalidraw/types';
+import type { Doc as YDoc, Transaction } from 'yjs';
+
+export const WHITEBOARD_PROPERTY = 'affine:excalidraw';
+export const WHITEBOARD_DATA = 'affine:excalidraw:v1';
+
+export type WhiteboardScene = {
+  elements: readonly ExcalidrawElement[];
+  appState: Partial<AppState>;
+  files: BinaryFiles;
+};
+
+// Only durable settings belong in the document. Selection, dialogs, collaborators,
+// DOM references, and the user's AFFiNE theme must never enter shared storage.
+export function canvasSettings(state: Partial<AppState>): Partial<AppState> {
+  return {
+    viewBackgroundColor: state.viewBackgroundColor,
+    gridSize: state.gridSize,
+    gridStep: state.gridStep,
+    gridModeEnabled: state.gridModeEnabled,
+    scrollX: state.scrollX,
+    scrollY: state.scrollY,
+    zoom: state.zoom,
+    currentItemStrokeColor: state.currentItemStrokeColor,
+    currentItemBackgroundColor: state.currentItemBackgroundColor,
+    currentItemFillStyle: state.currentItemFillStyle,
+    currentItemStrokeWidth: state.currentItemStrokeWidth,
+    currentItemStrokeStyle: state.currentItemStrokeStyle,
+    currentItemRoughness: state.currentItemRoughness,
+    currentItemOpacity: state.currentItemOpacity,
+    currentItemFontFamily: state.currentItemFontFamily,
+    currentItemFontSize: state.currentItemFontSize,
+  };
+}
+
+export class WhiteboardSceneStore {
+  private readonly data;
+  private knownElements = new Set<string>();
+  private knownFiles = new Map<string, BinaryFiles[string]>();
+  readonly origin = {};
+
+  constructor(private readonly doc: YDoc) {
+    this.data = doc.getMap<string>(WHITEBOARD_DATA);
+  }
+
+  read(): WhiteboardScene {
+    const elements: ExcalidrawElement[] = [];
+    const files: BinaryFiles = {};
+    for (const [key, value] of this.data) {
+      if (key.startsWith('element:')) elements.push(JSON.parse(value));
+      if (key.startsWith('file:')) files[key.slice(5)] = JSON.parse(value);
+    }
+    // Fractional indices preserve the editor's stacking order, including after
+    // Yjs merges changes from another device.
+    // Compare indices as ASCII, as Excalidraw's fractional-indexing does.
+    elements.sort((a, b) =>
+      (a.index ?? '') < (b.index ?? '')
+        ? -1
+        : (a.index ?? '') > (b.index ?? '')
+          ? 1
+          : 0
+    );
+    this.knownElements = new Set(elements.map(element => element.id));
+    this.knownFiles = new Map(Object.entries(files));
+    return {
+      elements,
+      files,
+      appState: JSON.parse(this.data.get('settings') ?? '{}'),
+    };
+  }
+
+  write(scene: WhiteboardScene) {
+    this.doc.transact(() => {
+      const put = (key: string, value: unknown) => {
+        const serialized = JSON.stringify(value);
+        if (this.data.get(key) !== serialized) this.data.set(key, serialized);
+      };
+      // Per-element entries avoid rewriting a whole scene or every image on
+      // each pointer movement. Deleted elements remain as Excalidraw tombstones.
+      for (const element of scene.elements) {
+        const key = `element:${element.id}`;
+        const existing = this.data.get(key);
+        if (existing) {
+          const saved = JSON.parse(existing) as ExcalidrawElement;
+          if (saved.version > element.version) continue;
+          if (saved.version === element.version) {
+            if (saved.versionNonce < element.versionNonce) continue;
+            if (
+              saved.versionNonce === element.versionNonce &&
+              saved.index === element.index
+            )
+              continue;
+          }
+        }
+        put(key, element);
+      }
+      const incoming = new Set(scene.elements.map(element => element.id));
+      // Loading a .excalidraw file replaces a scene. Tombstone elements absent
+      // from that replacement so the previous drawing cannot reappear on reopen.
+      for (const id of this.knownElements) {
+        if (incoming.has(id)) continue;
+        const value = this.data.get(`element:${id}`);
+        if (!value) continue;
+        const element = JSON.parse(value) as ExcalidrawElement;
+        if (!element.isDeleted)
+          put(`element:${id}`, {
+            ...element,
+            isDeleted: true,
+            version: element.version + 1,
+            updated: Date.now(),
+          });
+      }
+      this.knownElements = incoming;
+      // Images are self-contained in this synced document. They are written once,
+      // not on every scene change, and survive trash, duplication and offline use.
+      for (const [id, file] of Object.entries(scene.files)) {
+        const saved = this.knownFiles.get(id);
+        if (saved?.dataURL === file.dataURL && saved.mimeType === file.mimeType)
+          continue;
+        put(`file:${id}`, file);
+        this.knownFiles.set(id, file);
+      }
+      put('settings', canvasSettings(scene.appState));
+    }, this.origin);
+  }
+
+  observe(callback: () => void) {
+    const observer = (_event: unknown, transaction: Transaction) => {
+      if (transaction.origin !== this.origin) callback();
+    };
+    this.data.observe(observer);
+    return () => this.data.unobserve(observer);
+  }
+
+  readLibrary(): LibraryItems {
+    return JSON.parse(this.data.get('library') ?? '[]');
+  }
+
+  writeLibrary(items: LibraryItems) {
+    const value = JSON.stringify(items);
+    if (this.data.get('library') !== value) {
+      this.doc.transact(() => this.data.set('library', value), this.origin);
+    }
+  }
+}
+
+// Called by AFFiNE's ordinary Duplicate command as well as the board list.
+export function copyWhiteboardData(source: YDoc, target: YDoc) {
+  const data = source.getMap<string>(WHITEBOARD_DATA);
+  if (!data.size) return;
+  target.transact(() => {
+    const destination = target.getMap<string>(WHITEBOARD_DATA);
+    for (const [key, value] of data) destination.set(key, value);
+  });
+}
