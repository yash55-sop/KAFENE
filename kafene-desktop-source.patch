diff --git a/integrations/whiteboard/storage.mjs b/integrations/whiteboard/storage.mjs
new file mode 100644
index 0000000000..fa5ba9b7ce
--- /dev/null
+++ b/integrations/whiteboard/storage.mjs
@@ -0,0 +1,68 @@
+const DATABASE = 'affine-whiteboards';
+const STORE = 'boards';
+
+export function openBoardDatabase(indexedDB) {
+  return new Promise((resolve, reject) => {
+    const request = indexedDB.open(DATABASE, 1);
+    request.onupgradeneeded = () => request.result.createObjectStore(STORE);
+    request.onerror = () => reject(request.error);
+    request.onblocked = () =>
+      reject(new Error('Close other whiteboard tabs and retry.'));
+    request.onsuccess = () => {
+      request.result.onversionchange = () => request.result.close();
+      resolve(request.result);
+    };
+  });
+}
+
+export function readBoard(db, workspace, kind = 'scene') {
+  return new Promise((resolve, reject) => {
+    const request = db
+      .transaction(STORE)
+      .objectStore(STORE)
+      .get([workspace, kind]);
+    request.onsuccess = () => resolve(request.result ?? null);
+    request.onerror = () => reject(request.error);
+  });
+}
+
+export function writeBoard(db, workspace, value, kind = 'scene') {
+  return new Promise((resolve, reject) => {
+    const transaction = db.transaction(STORE, 'readwrite');
+    transaction.objectStore(STORE).put(value, [workspace, kind]);
+    transaction.oncomplete = () => resolve();
+    transaction.onabort = () =>
+      reject(transaction.error ?? new Error('Save aborted'));
+    transaction.onerror = () => reject(transaction.error);
+  });
+}
+
+// One write in flight per board. Coalesce rapid pointer changes without a timer,
+// so leaving the page never abandons a debounced save.
+export function createSaveQueue(write, report = () => {}) {
+  let pending;
+  let running;
+  const drain = async () => {
+    report('saving');
+    try {
+      while (pending !== undefined) {
+        const next = pending;
+        pending = undefined;
+        await write(next);
+      }
+      report('saved');
+    } catch (error) {
+      report('error', error);
+    } finally {
+      running = undefined;
+    }
+  };
+  return {
+    save(value) {
+      pending = value;
+      running ??= drain();
+      return running;
+    },
+    flush: () => running ?? Promise.resolve(),
+  };
+}
diff --git a/integrations/whiteboard/storage.test.mjs b/integrations/whiteboard/storage.test.mjs
new file mode 100644
index 0000000000..c17a5698cc
--- /dev/null
+++ b/integrations/whiteboard/storage.test.mjs
@@ -0,0 +1,63 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { IDBFactory } from 'fake-indexeddb';
+import {
+  createSaveQueue,
+  openBoardDatabase,
+  readBoard,
+  writeBoard,
+} from './storage.mjs';
+
+test('drawings, viewport and image files survive reopening and stay scoped to a workspace', async () => {
+  const factory = new IDBFactory();
+  const db = await openBoardDatabase(factory);
+  const scene = {
+    elements: [{ id: 'image', fileId: 'file-1' }],
+    appState: { zoom: { value: 1.5 } },
+    files: { 'file-1': { dataURL: 'data:image/png;base64,test' } },
+  };
+  await writeBoard(db, 'workspace-a', scene);
+  await writeBoard(db, 'workspace-a', [{ id: 'library-item' }], 'library');
+  db.close();
+  const reopened = await openBoardDatabase(factory);
+  assert.deepEqual(await readBoard(reopened, 'workspace-a'), scene);
+  assert.equal(await readBoard(reopened, 'workspace-b'), null);
+  assert.deepEqual(await readBoard(reopened, 'workspace-a', 'library'), [
+    { id: 'library-item' },
+  ]);
+  reopened.close();
+});
+
+test('rapid drawing updates save the most recent state after an in-flight write', async () => {
+  let release;
+  const gate = new Promise(resolve => {
+    release = resolve;
+  });
+  const writes = [];
+  const queue = createSaveQueue(async value => {
+    await gate;
+    writes.push(value);
+  });
+  queue.save('first');
+  queue.save('second');
+  queue.save('latest');
+  release();
+  await queue.flush();
+  assert.deepEqual(writes, ['first', 'latest']);
+});
+
+test('failed saves report an error and subsequent changes can save again', async () => {
+  const status = [];
+  let fail = true;
+  const queue = createSaveQueue(
+    async () => {
+      if (fail) throw new Error('Quota exceeded');
+    },
+    state => status.push(state)
+  );
+  await queue.save('drawing');
+  assert.equal(status.at(-1), 'error');
+  fail = false;
+  await queue.save('next drawing');
+  assert.equal(status.at(-1), 'saved');
+});
